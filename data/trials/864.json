,"city":"Sugar Land","state":"Texas","country":"United States"},{"facility":"Research Site","city":"Charlottesville","state":"Virginia","country":"United States"},{"facility":"Research Site","city":"Fairfax","state":"Virginia","country":"United States"},{"facility":"Research Site","city":"Midlothian","state":"Virginia","country":"United States"},{"facility":"Research Site","city":"Norfolk","state":"Virginia","country":"United States"},{"facility":"Research Site","city":"Roanoke","state":"Virginia","country":"United States"},{"facility":"Research Site","city":"Tacoma","state":"Washington","country":"United States"},{"facility":"Research Site","city":"Madison","state":"Wisconsin","country":"United States"}],"outcomes":[{"kind":"primary","measure":"Progression Free Survival (PFS)","time_frame":"From randomisation until progression per RECIST 1.1 as assessed by BICR, or death due to any cause (anticipated to be up to 33 months)."},{"kind":"secondary","measure":"Overall Survival (OS)","time_frame":"From randomisation until the date of death due to any cause (anticipated to be up to 64 months)."},{"kind":"secondary","measure":"Objective Response Rate (ORR)","time_frame":"From randomisation up until progression (anticipated to be up to 33 months)."},{"kind":"secondary","measure":"Duration of Response (DoR)","time_frame":"From the date of first documented response until date of documented progression per RECIST 1.1, as assessed by BICR/investigator assessment or death due to any cause (anticipated to be up to 33 months)."},{"kind":"secondary","measure":"Progression-Free Survival (PFS) by Investigator assessment","time_frame":"From randomisation until progression per RECIST 1.1 as assessed by the investigator, or death due to any cause (anticipated to be up to 33 months)."},{"kind":"secondary","measure":"Clinical Benefit Rate (CBR) at 24 weeks","time_frame":"From randomisation up until progression, or the last evaluable assessment in the absence of progression (anticipated t